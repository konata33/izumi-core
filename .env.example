NODE_ENV=development
# Used by manual `pnpm dev` runs and the checked-in Conductor workspace script.
PORT=3001
# Used by manual `pnpm dev:admin` runs and the checked-in Conductor workspace script.
ADMIN_PORT=5173
CORS_ORIGIN=http://localhost:3000,http://localhost:5173
DATABASE_URL=postgres://izumi:izumi@127.0.0.1:54329/izumi_core
REDIS_URL=redis://127.0.0.1:6389
JWT_EXPIRES_IN=7d
CORE_PUBLIC_URL=http://localhost:3001
IZUMI_DATA_DIR=.data

# Local storage is the default. S3/R2 is configured in the authenticated Admin.
MEDIA_LOCAL_DIR=.data/uploads
MEDIA_IMAGE_MAX_BYTES=20971520
MEDIA_VIDEO_MAX_BYTES=524288000

# Optional deployment-default AI provider. Owner BYOK profiles use the encryption key.
# AI_PROVIDER_TYPE=openai-compatible
# AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4.1
# AI_API_KEY=replace-with-provider-key
# Core creates persistent JWT and credential-encryption secrets under IZUMI_DATA_DIR.
# Production secret managers may override them with JWT_SECRET and
# CREDENTIALS_ENCRYPTION_KEY (canonical base64 for exactly 32 random bytes).
