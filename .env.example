NODE_ENV=development
# Used by manual `pnpm dev` runs and the checked-in Conductor workspace script.
PORT=3001
# Used by manual `pnpm dev:admin` runs and the checked-in Conductor workspace script.
ADMIN_PORT=5173
CORS_ORIGIN=http://localhost:3000,http://localhost:5173
DATABASE_URL=postgres://izumi:izumi@127.0.0.1:54329/izumi_core
REDIS_URL=redis://127.0.0.1:6389
JWT_SECRET=replace-with-a-long-random-secret-before-production
JWT_EXPIRES_IN=7d
OWNER_SETUP_TOKEN=replace-with-a-separate-long-random-bootstrap-secret

# Optional S3-compatible media storage. Configure the complete group or leave it unset.
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=izumi-media
S3_ACCESS_KEY_ID=izumi
S3_SECRET_ACCESS_KEY=izumi-development-secret
S3_PUBLIC_BASE_URL=http://127.0.0.1:9000/izumi-media
S3_FORCE_PATH_STYLE=true
# Local browser uploads may use *. Production should list only the Admin origin.
MINIO_API_CORS_ALLOW_ORIGIN=*
MEDIA_IMAGE_MAX_BYTES=20971520
MEDIA_VIDEO_MAX_BYTES=524288000

# Optional deployment-default AI provider. Owner BYOK profiles use the encryption key.
# AI_PROVIDER_TYPE=openai-compatible
# AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4.1
# AI_API_KEY=replace-with-provider-key
# Local-only key so the BYOK settings screen is available after `cp`.
# Production must replace it; generate one with: openssl rand -base64 32
AI_CREDENTIALS_ENCRYPTION_KEY=AQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQE=
